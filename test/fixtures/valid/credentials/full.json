{
  "$schema": "https://devbox.zenit-hosting.de/schema/credentials.v1.json",
  "$comment": "Every property of credentials.v1.json used once.",
  "instances": {
    "company-registry": {
      "type": "registry",
      "origin": "profile:example-team",
      "label": "Company registry",
      "fields": { "url": "https://nexus.example.com", "layout": "nexus", "username": "j.doe" },
      "consumers": { "pip": { "repository": "pypi-group" } },
      "secret": {
        "ref": "keyring:devbox/company-registry",
        "updatedAt": "2026-10-27T09:12:00Z",
        "expiresAt": "2027-01-25T00:00:00Z"
      },
      "verified": {
        "at": "2026-10-27T09:12:01Z",
        "status": "ok",
        "message": "Token accepted by nexus.example.com"
      },
      "applied": { "npm": "2026-10-27T09:12:03Z", "pip": "2026-10-27T09:12:04Z" }
    },
    "personal-key": {
      "type": "ssh-key",
      "origin": "user",
      "fields": {
        "path": "${env:HOME}/.ssh/id_ed25519",
        "comment": "j.doe@example.com",
        "port": 22,
        "agent": true
      },
      "secret": {
        "ref": "age:devbox/personal-key",
        "updatedAt": "2026-10-01T08:00:00Z",
        "expiresAt": null
      },
      "verified": {
        "at": "2026-10-01T08:00:01Z",
        "status": "failed",
        "message": "Public key does not match"
      }
    }
  }
}
