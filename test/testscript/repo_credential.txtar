# Private plugin repositories over https: a credential instance (type registry or
# git-host) gives the download its Authorization header. The host is a fake with a
# self-signed certificate that answers 401 without the secret. The secret reaches only
# the download, never output, state, history or the configuration.

[!exec:tar] skip 'tar is not installed'

host start srv
host accept alice t0k3n-ok
env SSL_CERT_FILE=$HOSTCA

# the tarball of the plugins
exec tar czf srv/dl/plugins.tar.gz -C pack .

# without a credential the host says no
! exec devbox repo add open --source $HOST/dl/plugins.tar.gz --path plugins
stderr 'download open: 401 Unauthorized'
exec devbox repo list --json
stdout '"name": "open"'
stdout '"lastError": "download open: 401 Unauthorized"'
exec devbox repo remove open

# a credential must exist, be a registry or git-host and fit the source
! exec devbox repo add priv --source $HOST/dl/plugins.tar.gz --path plugins --credential company
stderr 'credential company does not exist'
! exec devbox repo add priv --source git+ssh://git@example.com/p.git --credential company
stderr 'validation: credential is not supported for git\+ssh sources'
! exec devbox repo add priv --source file://$WORK/pack --credential company
stderr 'credential is only used with https and git\+https sources'
! exec devbox repo add priv --source https://alice:pw@example.com/p.tgz
stderr 'must not contain a user name or password'

# registry (layout custom, no user name): Bearer; the verification of the instance
# trusts the host through ~/.curlrc
exec devbox cred add company --type registry --field url=$HOST --field layout=custom
stdin token.txt
exec devbox cred set company --from-stdin
stdout 'company: secret saved'
exec devbox repo add priv --source $HOST/dl/plugins.tar.gz --path plugins --credential company
stdout 'priv: revision [0-9a-f]{12} waits for approval'
stdout '\+ alpha 1.0.0'
exec devbox repo list --json
stdout '"credential": "company"'
exec devbox repo approve priv --yes
exec devbox plugin list
stdout '^alpha +1.0.0 +ready +repository:priv@'

# a wrong secret is a 401 in the state; the active revision stays
stdin wrong.txt
exec devbox cred set company --from-stdin
! exec devbox repo sync priv
stderr 'download priv: 401 Unauthorized'
! stderr 't0k3n'
exec devbox repo list --json
stdout '"state": "error"'
stdout '"active": \{'
stdout '"lastError": "download priv: 401 Unauthorized"'

# the credential is not for this host: nothing is sent
exec devbox cred add elsewhere --type registry --field url=https://repo.example.invalid
stdin token.txt
! exec devbox cred set elsewhere --from-stdin
! exec devbox repo set priv --credential elsewhere
stderr 'credential elsewhere is for repo.example.invalid, not for 127.0.0.1'
! stderr 't0k3n'
exec devbox repo list --json
stdout '"lastError": "credential elsewhere is for repo.example.invalid, not for 127.0.0.1"'

# an instance without secret
exec devbox cred add nosecret --type registry --field url=$HOST
! exec devbox repo set priv --credential nosecret
stderr 'credential nosecret has no secret; set one with devbox cred set nosecret'

# remove the credential again: the host answers 401 as before
! exec devbox repo set priv --credential ''
stderr 'download priv: 401 Unauthorized'

# git-host (flavor gitlab): PRIVATE-TOKEN, the same for the registry with layout gitlab
exec devbox cred add lab --type git-host --field url=$HOST --field flavor=gitlab
stdin token.txt
exec devbox cred set lab --from-stdin
stdout 'lab verified: Accepted by the Git host \(HTTP 200\)'
exec devbox repo set priv --credential lab
stdout 'priv: up to date'
exec devbox cred add lab2 --type registry --field url=$HOST --field layout=gitlab
stdin token.txt
exec devbox cred set lab2 --from-stdin
exec devbox repo set priv --credential lab2
stdout 'priv: up to date'

# registry with a user name: basic authentication
exec devbox cred add basic --type registry --field url=$HOST --field layout=custom --field username=alice
stdin token.txt
exec devbox cred set basic --from-stdin
exec devbox repo set priv --credential basic
stdout 'priv: up to date'

host log
stdout '^GET /dl/plugins.tar.gz auth=none ok=false$'
stdout '^GET /dl/plugins.tar.gz auth=bearer ok=true$'
stdout '^GET /dl/plugins.tar.gz auth=bearer ok=false$'
stdout '^GET /dl/plugins.tar.gz auth=private-token ok=true$'
stdout '^GET /dl/plugins.tar.gz auth=basic:alice ok=true$'
stdout '^GET /api/v4/user auth=private-token ok=true$'
! stdout 'repo.example.invalid'

# the secret is in no file but the vault (encrypted), and in no output
! exec grep -r 't0k3n-ok' home/.local/state home/.config home/.local/share/devbox/credentials.json home/.local/share/devbox/repositories
exec grep '"credential": "basic"' home/.config/devbox/config.json

-- token.txt --
t0k3n-ok
-- wrong.txt --
wrong-t0k3n
-- pack/repo-main/plugins/alpha/plugin.json --
{ "id": "alpha", "version": "1.0.0", "name": "Alpha", "category": "tool" }
-- srv/dl/.keep --
-- home/.config/devbox/config.json --
{
  "plugins": { "disabled": ["base", "java"] },
  "vault": { "backend": "age" }
}
