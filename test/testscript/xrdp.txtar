-- bin/sudo --
#!/bin/sh
# runs only the fakes of this test and file tools, so a test can never touch the real system
case "$1" in
apt-get | systemctl | env | cp | install | mkdir | rm | cat | test) exec "$@" ;;
esac
echo "sudo: $1 not allowed in this test" >&2
exit 1
-- bin/dpkg-query --
#!/bin/sh
# dpkg-query -W -f=${Status} NAME
for name; do :; done
if [ -e "$(dirname "$0")/../pkgs/$name" ]; then
  printf 'install ok installed'
  exit 0
fi
echo "dpkg-query: no packages found matching $name" >&2
exit 1
-- bin/apt-get --
#!/bin/sh
dir=$(dirname "$0")/..
echo "$*" >>"$dir/apt.log"
if [ "$1" = install ] && [ "$2" = -y ]; then
  shift 2
  for name; do
    : >"$dir/pkgs/$name"
    # the package xrdp brings the units
    if [ "$name" = xrdp ]; then
      : >"$dir/units/xrdp"
      : >"$dir/units/xrdp-sesman"
    fi
  done
fi
exit 0
-- bin/systemctl --
#!/bin/sh
dir=$(dirname "$0")/..
case "$1" in
cat) [ -e "$dir/units/$2" ] ;;
is-active)
  shift
  [ "$1" = --quiet ] && shift
  [ -e "$dir/active/$1" ]
  ;;
is-enabled)
  if [ -e "$dir/enabled/$2" ]; then
    echo enabled
  else
    echo disabled
    exit 1
  fi
  ;;
enable | disable | restart)
  echo "$*" >>"$dir/systemctl.log"
  cmd=$1
  shift
  [ "$1" = --now ] && shift
  for unit; do
    [ -e "$dir/units/$unit" ] || exit 5
    case "$cmd" in
    enable)
      : >"$dir/enabled/$unit"
      : >"$dir/active/$unit"
      ;;
    disable) rm -f "$dir/enabled/$unit" "$dir/active/$unit" ;;
    restart) : >"$dir/active/$unit" ;;
    esac
  done
  ;;
*)
  echo "fake systemctl: unexpected $*" >&2
  exit 64
  ;;
esac
