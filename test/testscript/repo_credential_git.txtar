# Private plugin repositories over Git on https (git+https://): the fake host answers
# 401 with a basic challenge until Git sends the credential. Git asks `devbox repo
# git-credential` (the credential helper of this call) for it; helpers of the user are
# reset for the call. The secret is in no argument and no environment variable of Git.

[!exec:git] skip 'git is not installed'

env GIT_AUTHOR_NAME=Test GIT_AUTHOR_EMAIL=test@example.com GIT_AUTHOR_DATE=2026-10-29T09:00:00Z
env GIT_COMMITTER_NAME=Test GIT_COMMITTER_EMAIL=test@example.com GIT_COMMITTER_DATE=2026-10-29T09:00:00Z
cd src
exec git init --quiet --initial-branch=main
exec git add .
exec git -c commit.gpgsign=false commit --quiet -m one
cd ..
exec git clone --quiet --bare src srv/team/plugins.git

host start srv
host accept oauth2 t0k3n-ok
env GIT_SSL_CAINFO=$HOSTCA

# without a credential Git gets 401, and the helper of the user (a wrong password) does not help
! exec devbox repo add pub --source git+$HOST/team/plugins.git --path plugins
stderr 'prerequisite: git clone failed'
exec devbox repo remove pub

# the credential: a git-host with the default user name
exec devbox cred add gh --type git-host --field url=$HOST --field flavor=generic
stdin token.txt
exec devbox cred set gh --from-stdin
stdout 'gh verified: Git host reachable'
exec devbox repo add priv --source git+$HOST/team/plugins.git --path plugins --credential gh
stdout 'priv: revision [0-9a-f]{12} waits for approval'
stdout '\+ gamma 1.0.0'
! stderr 't0k3n'
exec devbox repo approve priv --yes
exec devbox plugin list
stdout '^gamma +1.0.0 +ready +repository:priv@'

# a new commit shows up with the next sync; the branch is fetched with the credential, too
mkdir src/plugins/delta
cp more/delta.json src/plugins/delta/plugin.json
cd src
exec git add .
exec git -c commit.gpgsign=false commit --quiet -m two
exec git push --quiet ../srv/team/plugins.git main
cd ..
exec devbox repo set priv --ref main
stdout 'priv: revision [0-9a-f]{12} waits for approval \(active: [0-9a-f]{12}\)'
stdout '\+ delta 1.0.0'
exec devbox repo sync priv
stdout 'priv: revision [0-9a-f]{12} waits for approval'

# the host saw the secret only as basic authentication with the user name of the instance
host log
stdout '^GET /team/plugins.git/info/refs auth=none ok=false$'
stdout '^GET /team/plugins.git/info/refs auth=basic:oauth2 ok=true$'
stdout '^POST /team/plugins.git/git-upload-pack auth=basic:oauth2 ok=true$'
# the wrong password of the helper of the user was tried once, by the call without a
# credential; with the credential its helper is reset, so it never comes up again
stdout -count=1 'auth=basic:oauth2 ok=false'

# the private directory with the secret is gone, and the secret is in no file of DevBox
! exec sh -c 'ls $WORK/.tmp | grep devbox-git-credential'
! exec grep -r 't0k3n-ok' home/.local/state home/.config home/.local/share/devbox/credentials.json home/.local/share/devbox/repositories

# the helper only answers for its own host, and only for Git's get
env DEVBOX_GIT_CREDENTIAL_FILE=$WORK/answer.txt
stdin request-own.txt
exec devbox repo git-credential --host 127.0.0.1:1 get
stdout '^username=oauth2\npassword=t0k3n-ok\n$'
stdin request-other.txt
exec devbox repo git-credential --host 127.0.0.1:1 get
! stdout .
stdin request-own.txt
exec devbox repo git-credential --host 127.0.0.1:1 store
! stdout .
env DEVBOX_GIT_CREDENTIAL_FILE=

-- token.txt --
t0k3n-ok
-- src/plugins/gamma/plugin.json --
{ "id": "gamma", "version": "1.0.0", "name": "Gamma", "category": "tool" }
-- more/delta.json --
{ "id": "delta", "version": "1.0.0", "name": "Delta", "category": "tool" }
-- answer.txt --
username=oauth2
password=t0k3n-ok
-- request-own.txt --
protocol=https
host=127.0.0.1:1

-- request-other.txt --
protocol=https
host=evil.example.com

-- home/.gitconfig --
[credential]
	helper = "!f() { echo username=oauth2; echo password=wrong-from-the-helper-of-the-user; }; f"
-- home/.config/devbox/config.json --
{
  "plugins": { "disabled": ["base", "java"] },
  "vault": { "backend": "age" }
}
