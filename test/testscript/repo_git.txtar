# Plugin repositories from a local Git repository (git+file://): with trust pinned the
# commit named in ref is active right away; with prompt it waits for approval.

[!exec:git] skip 'git is not installed'

# a repository with one commit; fixed names and dates give the same commit ID everywhere
env GIT_AUTHOR_NAME=Test GIT_AUTHOR_EMAIL=test@example.com GIT_AUTHOR_DATE=2026-10-29T09:00:00Z
env GIT_COMMITTER_NAME=Test GIT_COMMITTER_EMAIL=test@example.com GIT_COMMITTER_DATE=2026-10-29T09:00:00Z
cd src
exec git init --quiet --initial-branch=main
exec git add .
exec git -c commit.gpgsign=false commit --quiet -m one
exec git rev-parse HEAD
stdout '^ab91757e52a5938d28d802646d3c46cccd4f97c2$'
cd ..

# pinned: active without approval, .git is not kept
exec devbox repo add pinned --source git+file://$WORK/src --path plugins --ref ab91757e52a5938d28d802646d3c46cccd4f97c2 --trust pinned
stdout 'pinned: revision ab91757e52a5 is active \(1 plugins\)'
stdout '\* gamma 1.0.0'
exec devbox plugin list
stdout '^gamma +1.0.0 +ready +repository:pinned@ab91757e52a5'
! exists home/.local/share/devbox/repositories/pinned/ab91757e52a5/.git
exists home/.local/share/devbox/repositories/pinned/ab91757e52a5/plugins/gamma/plugin.json

# a second commit does not matter for the pinned entry
mkdir src/plugins/delta
cp more/delta.json src/plugins/delta/plugin.json
cd src
exec git add .
exec git -c commit.gpgsign=false commit --quiet -m two
cd ..
exec devbox repo sync pinned
stdout 'pinned: up to date'

# prompt on the branch: the new commit waits, and shows delta as added
exec devbox repo add branch --source git+file://$WORK/src --ref main --path plugins
stdout 'branch: revision [0-9a-f]{12} waits for approval'
stdout '\+ delta 1.0.0'
stdout '\+ gamma 1.0.0'

# the pinned configuration is checked when it is written
! exec devbox repo add bad --source git+file://$WORK/src --ref main --trust pinned
stderr 'trust pinned needs a git source and a full 40-character commit in ref'
! exec devbox repo add bad --source git+file://$WORK/src --ref no-such-branch
stderr 'prerequisite: git clone failed'
exec devbox repo list --json
stdout '"name": "bad"'
stdout '"state": "error"'

-- src/plugins/gamma/plugin.json --
{ "id": "gamma", "version": "1.0.0", "name": "Gamma", "category": "tool" }
-- more/delta.json --
{ "id": "delta", "version": "1.0.0", "name": "Delta", "category": "tool" }
