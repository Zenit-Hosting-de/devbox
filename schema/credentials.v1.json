{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devbox.zenit-hosting.de/schema/credentials.v1.json",
  "title": "DevBox credentials directory",
  "description": "Metadata of all credential instances (~/.local/share/devbox/credentials.json). Contains no secrets; secrets are kept in the vault.",
  "type": "object",
  "required": ["instances"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "URL of the schema this file follows."
    },
    "$comment": {
      "type": "string",
      "description": "Free-form comment; ignored by DevBox."
    },
    "instances": {
      "type": "object",
      "description": "Credential instances keyed by instance name.",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/instance" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 500 },
    "instance": {
      "type": "object",
      "description": "One credential instance.",
      "required": ["type", "origin"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/id",
          "description": "Credential type, e.g. registry, git-host, ssh-key or generic."
        },
        "origin": {
          "type": "string",
          "description": "Who created the instance: user or profile:<id>.",
          "pattern": "^(user|profile:[a-z][a-z0-9-]{1,31})$"
        },
        "label": {
          "$ref": "#/$defs/text",
          "description": "Display name of the instance."
        },
        "fields": {
          "type": "object",
          "description": "Field values without the secret; field names are defined by the credential type.",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        },
        "consumers": {
          "type": "object",
          "description": "Consumers added by the user, keyed by plugin ID, with consumer options.",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "type": "object" }
        },
        "secret": {
          "type": "object",
          "description": "Reference to the secret in the vault.",
          "required": ["ref"],
          "additionalProperties": false,
          "properties": {
            "ref": {
              "type": "string",
              "description": "Vault entry: keyring:<name> (Secret Service) or age:<name> (age-encrypted file).",
              "pattern": "^(keyring|age):[A-Za-z0-9._/-]+$"
            },
            "updatedAt": {
              "type": "string",
              "description": "When the secret was last set.",
              "format": "date-time"
            },
            "expiresAt": {
              "type": ["string", "null"],
              "description": "When the secret expires; null if it does not expire or the date is unknown.",
              "format": "date-time"
            }
          }
        },
        "verified": {
          "type": "object",
          "description": "Result of the last verification.",
          "required": ["at", "status"],
          "additionalProperties": false,
          "properties": {
            "at": {
              "type": "string",
              "description": "When the verification ran.",
              "format": "date-time"
            },
            "status": {
              "description": "Result of the verification.",
              "enum": ["ok", "failed"]
            },
            "message": {
              "type": "string",
              "description": "Message of the verification, e.g. the reason for a failure."
            }
          }
        },
        "applied": {
          "type": "object",
          "description": "When each consumer last applied the instance, keyed by plugin ID.",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
