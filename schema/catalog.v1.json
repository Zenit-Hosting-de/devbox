{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devbox.zenit-hosting.de/schema/catalog.v1.json",
  "title": "DevBox catalog index",
  "description": "index.json of a catalog repository, generated by the catalog's CI. Lists plugins with signed, versioned packages.",
  "type": "object",
  "required": ["generatedAt", "plugins"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "URL of this JSON Schema, for editor completion."
    },
    "$comment": {
      "type": "string",
      "description": "Free-form comment, ignored by DevBox."
    },
    "name": {
      "$ref": "#/$defs/text",
      "description": "Display name of the catalog."
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Time the index was generated, RFC 3339 UTC."
    },
    "plugins": {
      "type": "object",
      "description": "Plugins by plugin ID.",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/catalogPlugin",
        "description": "Catalog entry of one plugin."
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "catalogPlugin": {
      "type": "object",
      "description": "A plugin offered by the catalog with all its published versions.",
      "required": ["name", "versions"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/text",
          "description": "Display name of the plugin."
        },
        "description": {
          "$ref": "#/$defs/text",
          "description": "Short description shown in search results."
        },
        "category": {
          "enum": [
            "core",
            "system",
            "runtime",
            "tool",
            "credentials",
            "consumer",
            "projects",
            "remote",
            "maintenance",
            "language",
            "other"
          ],
          "description": "Category, same values as in the plugin manifest."
        },
        "homepage": {
          "type": "string",
          "format": "uri",
          "description": "Homepage or source of the plugin."
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "description": "Published versions, newest first.",
          "items": {
            "$ref": "#/$defs/release",
            "description": "One published version."
          }
        }
      }
    },
    "release": {
      "type": "object",
      "description": "One published version of a plugin.",
      "required": ["version", "url", "digest", "bundle", "publishedAt"],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$",
          "description": "Semantic version of the release."
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "description": "HTTPS URL of the package tarball, or a path relative to index.json."
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "SHA-256 digest of the package tarball, as sha256:<64 lower-case hex digits>."
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "description": "URL or path relative to index.json of the cosign signature of the tarball."
        },
        "bundle": {
          "type": "string",
          "minLength": 1,
          "description": "URL or path relative to index.json of the Sigstore bundle (signature, certificate and transparency log entry). Required: catalog packages must be signed (docs/concept.md, section Sicherheit)."
        },
        "requires": {
          "$ref": "#/$defs/requires",
          "description": "Requirements of this release."
        },
        "permissions": {
          "$ref": "#/$defs/permissions",
          "description": "Permissions this release declares."
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Publication time, RFC 3339 UTC."
        },
        "yanked": {
          "type": "boolean",
          "default": false,
          "description": "True when the release was withdrawn; it is no longer offered for new installs."
        }
      }
    },
    "requires": {
      "type": "object",
      "description": "Requirements of a plugin release; same shape as requires in the plugin manifest.",
      "additionalProperties": false,
      "properties": {
        "devbox": {
          "type": "string",
          "description": "Version range of DevBox, e.g. >=1.0.0 <2.0.0."
        },
        "os": {
          "type": "array",
          "description": "Supported operating systems.",
          "items": {
            "enum": ["linux"],
            "description": "Operating system."
          }
        },
        "arch": {
          "type": "array",
          "description": "Supported CPU architectures.",
          "items": {
            "enum": ["amd64", "arm64"],
            "description": "CPU architecture."
          }
        },
        "distro": {
          "type": "array",
          "description": "Supported distributions; empty or missing means all.",
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "Distribution ID as in os-release, e.g. ubuntu."
          }
        },
        "commands": {
          "type": "array",
          "description": "Commands that must be found in PATH.",
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "Command name."
          }
        },
        "plugins": {
          "type": "object",
          "description": "Other plugins by ID with the version range each must satisfy.",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "type": "string",
            "description": "Version range of the required plugin."
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "description": "Permissions a plugin release declares; same shape as permissions in the plugin manifest. Shown for confirmation before install and again on updates with new permissions.",
      "additionalProperties": false,
      "properties": {
        "network": {
          "type": "array",
          "description": "Network targets the plugin contacts.",
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "URL or placeholder that resolves to one."
          }
        },
        "files": {
          "type": "object",
          "description": "File system paths the plugin reads or writes.",
          "additionalProperties": false,
          "properties": {
            "read": {
              "type": "array",
              "description": "Readable paths.",
              "items": {
                "type": "string",
                "minLength": 1,
                "description": "Path or placeholder that resolves to one."
              }
            },
            "write": {
              "type": "array",
              "description": "Writable paths.",
              "items": {
                "type": "string",
                "minLength": 1,
                "description": "Path or placeholder that resolves to one."
              }
            }
          }
        },
        "sudo": {
          "type": "boolean",
          "default": false,
          "description": "True when actions of the plugin use sudo."
        },
        "credentials": {
          "type": "array",
          "description": "Credential types the plugin may read.",
          "items": {
            "$ref": "#/$defs/id",
            "description": "Credential type ID."
          }
        }
      }
    }
  }
}
