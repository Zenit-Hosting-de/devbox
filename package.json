{
  "name": "devbox",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "web",
    "sdk/ts"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "eslint . && npm run --silent format:check",
    "format": "prettier --write '**/*.{ts,mjs,json}' '!test/fixtures/**' '!**/gen/**' '!**/dist/**' '!**/package-lock.json' '!docs/concept.md' '!graphify-out/**'",
    "format:check": "prettier --check '**/*.{ts,mjs,json}' '!test/fixtures/**' '!**/gen/**' '!**/dist/**' '!**/package-lock.json' '!docs/concept.md' '!graphify-out/**'",
    "test": "npm test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "json-schema-to-typescript": "16.0.0",
    "lefthook": "2.2.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
