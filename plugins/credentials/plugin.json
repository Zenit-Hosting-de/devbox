{
  "$schema": "https://devbox.zenit-hosting.de/schema/plugin.v1.json",
  "id": "credentials",
  "version": "1.0.0",
  "name": "Credentials",
  "description": "Warns before secrets of credential instances expire",
  "category": "credentials",
  "icon": "key",
  "license": "Apache-2.0",
  "authors": ["Zenit-Hosting"],
  "requires": {
    "devbox": ">=0.0.1",
    "os": ["linux"],
    "arch": ["amd64", "arm64"],
    "commands": ["date"]
  },
  "permissions": {
    "network": [],
    "files": { "read": ["${credentials.file}"], "write": [] },
    "sudo": false,
    "credentials": []
  },
  "settings": {
    "warnDays": {
      "type": "integer",
      "minimum": 0,
      "maximum": 365,
      "default": 14,
      "label": "Warn days before expiry"
    },
    "file": {
      "type": "string",
      "format": "path",
      "default": "${xdg:data}/devbox/credentials.json",
      "label": "Credentials directory",
      "help": "Metadata of the credential instances, without secrets.",
      "advanced": true
    }
  },
  "checks": {
    "expiry": {
      "label": "Expiry of credentials",
      "run": ["checks/expiry.sh"],
      "timeout": "10s",
      "cache": "1h"
    }
  },
  "i18n": { "default": "en", "dir": "i18n" }
}
