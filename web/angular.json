{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false,
    "cache": { "path": "node_modules/.cache/angular" }
  },
  "newProjectRoot": "projects",
  "projects": {
    "devbox-web": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "dbx",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": { "base": "../internal/api/dist/ui", "browser": "" },
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [{ "glob": "**/*", "input": "public" }],
            "styles": [
              "zenit-ui/styles/tokens.css",
              "@angular/cdk/overlay-prebuilt.css",
              "zenit-ui/styles/themes.css",
              "zenit-ui/styles/zenit-ui.css",
              "@xterm/xterm/css/xterm.css",
              "src/styles.css"
            ],
            "extractLicenses": false,
            "polyfills": []
          },
          "configurations": {
            "production": {
              "budgets": [
                { "type": "initial", "maximumWarning": "500kB", "maximumError": "1MB" },
                { "type": "anyComponentStyle", "maximumWarning": "8kB", "maximumError": "16kB" }
              ],
              "outputHashing": "all",
              "deployUrl": "/",
              "optimization": {
                "scripts": true,
                "styles": { "minify": true, "inlineCritical": false },
                "fonts": { "inline": false }
              }
            },
            "mock": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.mock.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "port": 4200, "host": "localhost" },
          "configurations": {
            "production": { "buildTarget": "devbox-web:build:production" },
            "development": { "buildTarget": "devbox-web:build:development" },
            "mock": { "buildTarget": "devbox-web:build:development,mock" }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest",
            "splitting": false,
            "buildTarget": "devbox-web:build:development,mock"
          }
        }
      }
    }
  }
}
